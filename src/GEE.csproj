<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GEE</AssemblyName>
    <RootNamespace>GEE</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The game install StarMap launches; override with dotnet build -p:KsaDir="...\" for another location. -->
    <KsaDir Condition="'$(KsaDir)' == ''">C:\Program Files\Ahwoo\Games\Kitten Space Agency\</KsaDir>
    <StarMapDir>$(MSBuildThisFileDirectory)..\..\StarMap\</StarMapDir>
    <OutDir>$(MSBuildThisFileDirectory)..\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KSA"><HintPath>$(KsaDir)KSA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepuUtilities"><HintPath>$(KsaDir)BepuUtilities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Numerics"><HintPath>$(KsaDir)Brutal.Numerics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core"><HintPath>$(KsaDir)Brutal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Collections"><HintPath>$(KsaDir)Brutal.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Logging"><HintPath>$(KsaDir)Brutal.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Strings"><HintPath>$(KsaDir)Brutal.Strings.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui"><HintPath>$(KsaDir)Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui.Abstractions"><HintPath>$(KsaDir)Brutal.ImGui.Abstractions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Vulkan.Vma"><HintPath>$(KsaDir)Brutal.Vulkan.Vma.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ShaderC"><HintPath>$(KsaDir)Brutal.ShaderC.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Stb"><HintPath>$(KsaDir)Brutal.Stb.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Memory"><HintPath>$(KsaDir)Brutal.Memory.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Vulkan"><HintPath>$(KsaDir)Brutal.Vulkan.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Vulkan.Abstractions"><HintPath>$(KsaDir)Brutal.Vulkan.Abstractions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Planet.Render.Core"><HintPath>$(KsaDir)Planet.Render.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StarMap.API"><HintPath>$(StarMapDir)StarMap.API.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(StarMapDir)0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="GeeMod.cs;Log.cs;Settings.cs;Buildings.cs;Roads.cs;VectorTile.cs;Footprint.cs;Placement.cs;Clutter.cs;ClutterClearing.cs;NightLights.cs;InstancedPass.cs;FacadeTechnique.cs;Tiles.cs;NetLoader.cs;DownloadGate.cs;BuildingRenderer.cs;Patches.cs;LightSet.cs;GlowTechnique.cs;GlowRenderer.cs;RegionalLights.cs;Landmarks.cs;AutoShot.cs;BuildingDetail.cs;Pipelines.cs;PipelineData.cs;Structures.cs;StructureData.cs;BuiltUp.cs;PublicLamps.cs;CrewArm.cs;Vapor.cs;FarField.cs;Satellite.cs;Perf.cs;ShaderPatch.cs;RoadJunctions.cs;RoadMerges.cs;RoadBridges.cs;WorldCover.cs;TreeCover.cs;ShadowCasters.cs;GroundTint.cs;TreePack.cs" />
  </ItemGroup>
</Project>
