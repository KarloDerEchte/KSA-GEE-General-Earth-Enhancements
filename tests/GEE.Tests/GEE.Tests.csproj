    <Compile Include="$(SrcDir)RoadFurniture.cs" Link="src/RoadFurniture.cs" />
    <Compile Include="$(SrcDir)JunctionMarkings.cs" Link="src/JunctionMarkings.cs" />
    <Compile Include="$(SrcDir)DownloadGate.cs" Link="src/DownloadGate.cs" />
    <Compile Include="$(SrcDir)Settings.cs" Link="src/Settings.cs" />
    <Compile Include="$(SrcDir)TowerMassing.cs" Link="src\TowerMassing.cs" />
